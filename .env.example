# Contact form back end (Vercel Serverless Function: api/contact.js).
# Copy to `.env` for local `vercel dev`, and add the same values to the Vercel
# project's Environment Variables. Never commit real values.

# Where enquiries are delivered.
CONTACT_TO=azeezaty.yusuf001@gmail.com

# From header on the email. For Gmail SMTP this must be the sending account.
CONTACT_FROM="Zeedev website <azeezaty.yusuf001@gmail.com>"

# --- Option A: Resend (recommended) -----------------------------------------
# Create a key at https://resend.com and verify a sending domain, or use
# onboarding@resend.dev while testing.
RESEND_API_KEY=

# --- Option B: SMTP (e.g. Gmail App Password) -------------------------------
# Requires 2-Step Verification on the Google account, then an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=azeezaty.yusuf001@gmail.com
SMTP_PASS=

# Optional build-time override; defaults to the same-origin /api/contact.
# VITE_CONTACT_ENDPOINT=
